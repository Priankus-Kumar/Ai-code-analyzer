{
  "info": {
    "name": "AI Agile Code Analyzer API",
    "description": "Comprehensive Postman collection for all endpoints of the AI-Powered Agile Code Analyzer MERN application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "analysisId",
      "value": "6640c3fe2a3f0d2b45123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check Health Diagnostics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Developer\",\n  \"email\": \"jane.dev@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.dev@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Analyses",
      "item": [
        {
          "name": "Submit Code for AI Analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Express Authentication Review\",\n  \"language\": \"javascript\",\n  \"focus\": \"security\",\n  \"sourceCode\": \"function verifyToken(token) {\\n  return jwt.verify(token, 'hardcoded_secret');\\n}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analyses",
              "host": ["{{baseUrl}}"],
              "path": ["analyses"]
            }
          }
        },
        {
          "name": "List Analyses (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analyses?page=1&limit=10&language=javascript&status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["analyses"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "language",
                  "value": "javascript"
                },
                {
                  "key": "status",
                  "value": "completed"
                },
                {
                  "key": "severity",
                  "value": "high",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "Auth",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Analysis By ID (with Agile Tasks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analyses/{{analysisId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analyses", "{{analysisId}}"]
            }
          }
        },
        {
          "name": "Update Finding Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analyses/{{analysisId}}/findings/6640c42a2a3f0d2b45123458",
              "host": ["{{baseUrl}}"],
              "path": ["analyses", "{{analysisId}}", "findings", "6640c42a2a3f0d2b45123458"]
            }
          }
        },
        {
          "name": "Delete Analysis Report",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analyses/{{analysisId}}",
              "host": ["{{baseUrl}}"],
              "path": ["analyses", "{{analysisId}}"]
            }
          }
        }
      ]
    }
  ]
}
